{
	"name": "supercharged-workspaces",
	"version": "0.0.8",
	"description": "Save, load, and manage workspace layouts with enhanced features for power users.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"postversion": "git push --follow-tags",
		"update": "ncu -i",
		"lint": "eslint --fix",
		"lint:fix": "eslint . --fix",
		"format": "prettier --config prettier.config.cjs --ignore-path .prettierignore --write .",
		"format:check": "prettier --config prettier.config.cjs --ignore-path .prettierignore --check .",
		"cleancache": "pnpm store prune",
		"clean": "rm -rf node_modules pnpm-lock.yaml main.js && pnpm store prune"
	},
	"keywords": [],
	"author": "Kieran Mansfield",
	"packageManager": "pnpm@12.5.1",
	"license": "MIT",
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@types/node": "^26.6.2",
		"@typescript-eslint/parser": "8.70.1",
		"builtin-modules": "5.4.0",
		"esbuild": "0.28.2",
		"eslint": "^10.11.0",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"obsidian": "latest",
		"prettier": "^3.9.8",
		"typescript": "6.0.3",
		"typescript-eslint": "^8.70.1",
		"vitest": "^5.0.1"
	}
}
